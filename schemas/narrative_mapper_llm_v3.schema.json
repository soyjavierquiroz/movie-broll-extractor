{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "narrative_mapper_llm_v3",
  "type": "object",
  "required": ["schema_version", "chunk_summary_es", "segments"],
  "properties": {
    "schema_version": {"const": "narrative_mapper_llm_v3"},
    "chunk_summary_es": {"type": "string"},
    "segments": {"type": "array", "items": {"type": "object", "required": ["first_cue_id", "last_cue_id", "segment_type", "narrative_summary_es", "situation_es", "participants_es", "interaction_action_es", "location_context_es", "narrative_tone", "narrative_function", "context_dependency", "continuity_previous", "continuity_next", "continuity_rationale_es", "transition_reason_start", "boundary_reason_end", "long_segment_reason", "possible_visual_opportunities"], "properties": {
      "first_cue_id": {"type": "string", "pattern": "^SRT_[0-9]{6}$"},
      "last_cue_id": {"type": "string", "pattern": "^SRT_[0-9]{6}$"},
      "segment_type": {"enum": ["conversation", "monologue", "narration", "sparse_dialogue", "transition", "unknown"]},
      "narrative_summary_es": {"type": "string"}, "situation_es": {"type": "string"}, "participants_es": {"type": "string"}, "interaction_action_es": {"type": "string"}, "location_context_es": {"type": "string"},
      "narrative_tone": {"enum": ["neutral", "serious", "tense", "sad", "warm", "affectionate", "angry", "anxious", "humorous", "hopeful", "fearful", "reflective", "celebratory", "mixed", "unclear"]},
      "narrative_function": {"enum": ["exposition", "conversation", "conflict", "decision", "revelation", "setup", "transition", "resolution", "emotional_exchange", "everyday_interaction", "unknown"]},
      "context_dependency": {"enum": ["low", "medium", "high"]}, "continuity_previous": {"enum": ["same_interaction", "likely_same_interaction", "new_interaction", "outside_chunk", "unknown"]}, "continuity_next": {"enum": ["same_interaction", "likely_same_interaction", "new_interaction", "outside_chunk", "unknown"]}, "continuity_rationale_es": {"type": "string"},
      "transition_reason_start": {"enum": ["arrival", "call", "chunk_end", "chunk_start", "conflict_end", "conflict_start", "context_change", "continues_prior_situation", "departure", "interaction_change", "new_action", "participant_change", "phase_change", "phone_call_arrival_departure", "revelation", "subject_change", "time_jump", "unknown"]},
      "boundary_reason_end": {"enum": ["arrival", "call", "chunk_end", "chunk_start", "conflict_end", "conflict_start", "context_change", "continues_prior_situation", "departure", "interaction_change", "new_action", "participant_change", "phase_change", "phone_call_arrival_departure", "revelation", "subject_change", "time_jump", "unknown"]},
      "long_segment_reason": {"type": ["string", "null"], "enum": ["long_continuous_conversation", "continuous_action", "continuous_therapy_exchange", null]},
      "possible_visual_opportunities": {"type": "array", "items": {"enum": ["conversation", "listening", "reaction", "pause", "gesture", "movement", "object_interaction", "physical_interaction", "establishing", "transition", "unknown"]}}
    }}}
  }
}
