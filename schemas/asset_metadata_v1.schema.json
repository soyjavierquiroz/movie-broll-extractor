{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "asset_metadata_v1",
    "type": "object",
    "required": [
        "asset_metadata_v1",
        "asset",
        "media",
        "analysis",
        "source_timeline",
        "visual",
        "audio",
        "narrative",
        "editorial",
        "export",
        "thumbnail"
    ],
    "properties": {
        "asset_metadata_v1": {
            "const": "asset_metadata_v1"
        },
        "asset": {
            "type": "object",
            "required": [
                "source_asset_id",
                "source_movie_id"
            ],
            "properties": {
                "source_asset_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "source_movie_id": {
                    "type": "string"
                }
            }
        },
        "media": {
            "type": "object",
            "required": [
                "filename",
                "sha256",
                "duration_seconds",
                "width",
                "height",
                "fps",
                "orientation",
                "aspect_ratio"
            ],
            "properties": {
                "filename": {
                    "type": "string"
                },
                "sha256": {
                    "type": "string"
                },
                "duration_seconds": {
                    "type": "number"
                },
                "width": {
                    "type": "integer"
                },
                "height": {
                    "type": "integer"
                },
                "fps": {
                    "type": "number"
                },
                "orientation": {
                    "enum": [
                        "landscape",
                        "portrait",
                        "square"
                    ]
                },
                "aspect_ratio": {
                    "enum": [
                        "16:9",
                        "9:16",
                        "3:4",
                        "4:5",
                        "1:1",
                        "other"
                    ]
                },
                "horizontal": {
                    "type": "object"
                },
                "vertical": {
                    "type": "object"
                }
            }
        },
        "analysis": {
            "type": "object",
            "required": [
                "semantic_ready",
                "final_asset_semantics_validated",
                "source_video_analyzed",
                "profile",
                "producer",
                "producer_version",
                "generated_at"
            ],
            "properties": {
                "semantic_ready": {
                    "type": "boolean"
                },
                "final_asset_semantics_validated": {
                    "type": "boolean"
                },
                "source_video_analyzed": {},
                "profile": {
                    "type": "string"
                },
                "producer": {
                    "type": "string"
                },
                "producer_version": {
                    "type": "string"
                },
                "generated_at": {
                    "type": "string"
                },
                "visual_model": {},
                "narrative_model": {},
                "audio_processor": {}
            }
        },
        "source_timeline": {
            "type": "object",
            "properties": {
                "start_seconds": {
                    "type": "number"
                },
                "end_seconds": {
                    "type": "number"
                },
                "scene_block_id": {
                    "type": "string"
                },
                "visual_event_id": {
                    "type": "string"
                },
                "shot_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "visual": {
            "type": "object",
            "properties": {
                "summary_es": {
                    "type": "string"
                },
                "subjects": {
                    "type": "array"
                },
                "objects": {
                    "type": "array"
                },
                "actions": {
                    "$ref": "#/$defs/assertion"
                },
                "visible_emotions": {
                    "$ref": "#/$defs/assertion"
                },
                "interaction_labels": {
                    "$ref": "#/$defs/assertion"
                },
                "setting": {
                    "$ref": "#/$defs/assertion"
                },
                "people": {
                    "type": "object",
                    "properties": {
                        "contains_people": {
                            "type": "boolean"
                        },
                        "people_count": {
                            "type": "integer"
                        },
                        "composition": {
                            "enum": [
                                "single_subject",
                                "two_person",
                                "group",
                                "unknown",
                                "not_applicable"
                            ]
                        },
                        "overall_presentation": {
                            "enum": [
                                "masculine",
                                "feminine",
                                "mixed",
                                "unclear",
                                "not_applicable"
                            ]
                        },
                        "primary_subject": {
                            "type": "object",
                            "properties": {
                                "prominence": {
                                    "enum": [
                                        "foreground",
                                        "midground",
                                        "background",
                                        "unknown",
                                        "not_applicable"
                                    ]
                                },
                                "visibility": {
                                    "enum": [
                                        "clear",
                                        "partial",
                                        "back_view",
                                        "silhouette",
                                        "occluded",
                                        "not_applicable"
                                    ]
                                }
                            }
                        }
                    }
                },
                "keywords_es": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "search_terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "negative_use_cases": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "audio": {
            "type": "object",
            "properties": {
                "speech_present": {
                    "$ref": "#/$defs/assertion"
                }
            }
        },
        "narrative": {
            "type": "object",
            "properties": {
                "summary_es": {
                    "type": "string"
                },
                "tone": {},
                "interaction_labels": {},
                "themes": {},
                "srt_context": {
                    "type": "object",
                    "properties": {
                        "asset_overlap": {
                            "$ref": "#/$defs/srt_context"
                        },
                        "context_window": {
                            "$ref": "#/$defs/srt_context"
                        }
                    }
                }
            }
        },
        "editorial": {
            "type": "object",
            "properties": {
                "decision": {
                    "enum": [
                        "KEEP",
                        "REVIEW",
                        "REJECT"
                    ]
                },
                "broll_score": {
                    "type": "number"
                },
                "context_dependency": {},
                "technical_quality": {},
                "rejection_reasons": {
                    "type": "array"
                }
            }
        },
        "export": {
            "type": "object",
            "properties": {
                "orientation": {
                    "enum": [
                        "landscape",
                        "portrait",
                        "square"
                    ]
                },
                "aspect_ratio": {
                    "enum": [
                        "16:9",
                        "9:16",
                        "4:5",
                        "1:1",
                        "other"
                    ]
                },
                "reframe_applied": {
                    "type": "boolean"
                },
                "reframe_profile": {}
            }
        },
        "thumbnail": {
            "type": "object",
            "properties": {
                "filename": {
                    "type": "string"
                },
                "timestamp_seconds": {
                    "type": "number"
                }
            }
        }
    },
    "$defs": {
        "assertion": {
            "type": "object",
            "required": [
                "value",
                "source",
                "confidence"
            ],
            "properties": {
                "value": {},
                "source": {
                    "type": "string"
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "srt_context": {
            "type": "object",
            "properties": {
                "source": {
                    "const": "external_srt"
                },
                "literal_transcription": {
                    "const": false
                },
                "cues": {
                    "type": "array"
                }
            }
        }
    }
}
