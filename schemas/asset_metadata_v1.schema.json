{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"asset_metadata_v1", "type":"object",
  "required":["schema_version","asset","source","media","analysis","source_timeline","visual","editorial"],
  "properties":{
    "schema_version":{"const":"asset_metadata_v1"},
    "asset":{"type":"object","required":["id","source_movie_id"],"properties":{"id":{"type":"string","minLength":1},"slug":{"type":"string"},"source_movie_id":{"type":"string","minLength":1}},"not":{"required":["source_asset_id"]}},
    "source":{"type":"object","required":["movie_sha256"],"properties":{"movie_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "media":{"type":"object","required":["horizontal","vertical"],"properties":{"horizontal":{"$ref":"#/$defs/rendition"},"vertical":{"$ref":"#/$defs/rendition"}}},
    "analysis":{"type":"object","required":["producer","producer_version","generated_at","semantic_ready","final_asset_semantics_validated"],"properties":{"producer":{"const":"movie_broll_extractor"},"producer_version":{"type":"string"},"generated_at":{"type":"string"},"semantic_ready":{"const":true},"final_asset_semantics_validated":{"const":true}}},
    "source_timeline":{"type":"object","required":["start_seconds","end_seconds","visual_event_id","technical_shot_ids"],"properties":{"start_seconds":{"type":"number"},"end_seconds":{"type":"number"},"visual_event_id":{"type":"string"},"technical_shot_ids":{"type":"array","items":{"type":"string"}},"narrative_segment_ids":{"type":"array","items":{"type":"string"}}}},
    "visual":{"type":"object"}, "audio":{"type":"object"}, "narrative":{"type":"object"},
    "editorial":{"type":"object","required":["decision"],"properties":{"decision":{"const":"KEEP"}}}, "export":{"type":"object"}
  },
  "$defs":{
    "thumbnail":{"type":"object","required":["file","sha256","size_bytes","mime_type"],"properties":{"file":{"type":"string","pattern":"^[^/]+\\.jpg$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1},"mime_type":{"const":"image/jpeg"},"timestamp_seconds":{"type":"number"}}},
    "rendition":{"type":"object","required":["file","sha256","size_bytes","mime_type","duration_seconds","width","height","fps","orientation","aspect_ratio","technical_validated","semantic_validated","thumbnail"],"properties":{"file":{"type":"string","pattern":"^[^/]+\\.mp4$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1},"mime_type":{"const":"video/mp4"},"duration_seconds":{"type":"number"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"fps":{"type":"number","exclusiveMinimum":0},"orientation":{"enum":["landscape","portrait"]},"aspect_ratio":{"type":"string"},"technical_validated":{"const":true},"semantic_validated":{"const":true},"thumbnail":{"$ref":"#/$defs/thumbnail"}}}
  }
}
